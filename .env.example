# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=nexusai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nexusai_db
DATABASE_URL=postgresql://nexusai:changeme@db:5432/nexusai_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth JWT ────────────────────────────────────────────────────────────────
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_SECRETS_TOKEN_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Claude API ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ─── Pinecone ────────────────────────────────────────────────────────────────
PINECONE_API_KEY=CHANGE_ME
PINECONE_INDEX_NAME=nexusai

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
