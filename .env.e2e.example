# Variáveis para os smoke tests Playwright
# Copiar para .env.e2e e preencher — nunca commitar .env.e2e

# Credenciais de um tenant criado para testes e2e
E2E_SLUG=nexusai-e2e
E2E_EMAIL=test@nexusai-e2e.com
E2E_PASSWORD=SenhaSegura123!
E2E_API_KEY=

# URLs — padrão aponta para local
BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8001

# Produção:
# BASE_URL=https://nexusai.vercel.app
# NEXT_PUBLIC_API_URL=https://nexusai-api.onrender.com
